# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key-here
# Recommended on server to bypass RLS securely while keeping anon locked down:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication (use a strong random secret, >= 32 characters)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Optional: Additional comma-separated allowed CORS origins
# ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Optional: Order Confirmation Emails via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=TrueKicks <orders@yourdomain.com>
# FRONTEND_URL=https://truekicks-production.vercel.app

# Optional: Dedicated HMAC secret for Digital Authenticity Tags (defaults to JWT_SECRET)
# AUTHENTICITY_SECRET=replace-with-a-strong-random-secret

# Optional: AI Sneaker Concierge via Google AI Studio (https://aistudio.google.com/apikey)
# Falls back to deterministic catalog matcher automatically if unset or rate-limited
# GEMINI_API_KEY=your-google-ai-studio-api-key
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: Comma-separated bootstrap admin emails (works alongside users.role = 'admin')
# ADMIN_EMAILS=owner@truekicks.com

# Optional: Midtrans Snap Payment Gateway (https://dashboard.midtrans.com)
# Runs in local Sandbox Simulator mode automatically if unset
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=false
